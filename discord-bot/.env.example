# Copy to .env (never commit it). Blank channel id = that feature off.

# Bot token from https://discord.com/developers/applications (Bot tab). Required.
# Intents: Message Content (news). Permissions: View Channel, Read Message History, Send Messages,
# Embed Links, Manage Channels (status channel rename).
DISCORD_BOT_TOKEN=
# Server id: slash commands register there instantly (blank = global, up to an hour).
DISCORD_GUILD_ID=

# Status channel (a voice channel) renamed to "🟢 Online · N slayers" / "🔴 Offline".
DISCORD_STATUS_CHANNEL_ID=
# Backend health endpoint the status polls (backend's plain-HTTP port; same machine, or a private VPN address).
BACKEND_HEALTH_URL=http://127.0.0.1:3000/health/ready

# Announcements channel shown in the launcher's news dock.
DISCORD_NEWS_CHANNEL_ID=
# Where the backend reads news from (backend .env DISCORD_BOT_URL=http://<this host>:<port>).
# Keep 127.0.0.1 when bot and backend share a machine; a private VPN address when they don't. Never public: it has no password.
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=3100

# Folder for issues.json (the /issue tickets). Back it up.
BOT_DATA_DIR=data
