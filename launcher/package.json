{
  "name": "dauntless-revamped",
  "productName": "Dauntless Revamped",
  "version": "0.2.9",
  "description": "Windows launcher for Dauntless 1.14.7 servers running Mystic Paradox: join from an invite, create an account, download and verify the pinned 1.14.7 client and the server runtime, and play through a pinned-TLS relay.",
  "main": ".vite/build/main.js",
  "private": true,
  "homepage": "https://github.com/HyjinnxDev/dauntless-revamped",
  "repository": {
    "type": "git",
    "url": "https://github.com/HyjinnxDev/dauntless-revamped.git",
    "directory": "launcher"
  },
  "bugs": {
    "url": "https://github.com/HyjinnxDev/dauntless-revamped/issues"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --platform win32",
    "make": "electron-forge make --platform win32",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "icon": "node scripts/make-icon.mjs",
    "release": "npm run make && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-release.ps1 -Publish"
  },
  "keywords": [
    "dauntless",
    "launcher",
    "private-server",
    "mystic-paradox"
  ],
  "author": {
    "name": "Hyjinnx",
    "url": "https://github.com/HyjinnxDev"
  },
  "contributors": [
    {
      "name": "mixutin and the Dauntless Revived contributors, authors of the Dauntless Revived launcher this one is based on",
      "url": "https://github.com/mixutin/dauntless-revived"
    },
    {
      "name": "Gregory Morford (gwog), author of the upstream Undaunted launcher",
      "email": "realsystemdev@gmail.com",
      "url": "https://github.com/SyST3MDeV/Undaunted"
    }
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "electron": "44.4.3",
    "node-forge": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.1",
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
